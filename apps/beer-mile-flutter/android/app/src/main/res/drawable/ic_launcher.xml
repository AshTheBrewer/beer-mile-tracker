<?xml version="1.0" encoding="utf-8"?>
<!-- Beer Mile launcher icon — amber circle with a beer mug shape.
     Using a drawable (not mipmap) avoids the need for rasterised PNG files in
     every density bucket, which cannot be generated by text-based tooling.
     Replace this file with a proper adaptive icon set for App Store / Play
     Store submission. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background: amber circle -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#F59E0B"/>
        </shape>
    </item>
    <!-- Foreground: white centred square (placeholder for beer mug) -->
    <item
        android:left="28dp"
        android:top="28dp"
        android:right="28dp"
        android:bottom="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <corners android:radius="4dp"/>
        </shape>
    </item>
</layer-list>
